{
  "name": "vehicle-finder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply vehicle-finder --local",
    "db:seed:local": "wrangler d1 execute vehicle-finder --local --file seeds/0001_family_search.sql",
    "collect:carsforsale": "tsx src/sources/collect-carsforsale.ts",
    "score:fixtures": "tsx src/scoring/fixture-report.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/node": "^22.13.14",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "hono": "^4.13.4"
  }
}
